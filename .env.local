# Set environment to development
ENVIRONMENT=development

OPENAI_API_KEY=
SECRET_KEY=your_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000

# OLLAMA MODEL PATH (Mac OS)
LLAMA_MODEL_PATH=/Users/<username>/.ollama/models/manifests/<source>/<author>/<model-name>/<version>
LLAMA_MODEL_BLOB_PATH=/Users/<username>/.ollama/models/blobs/